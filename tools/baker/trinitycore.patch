+[[noreturn]] void FailSelection(char const* name, char const* value)
+{
+    printf("Invalid %s '%s'\n", name, value);
+    exit(1);
+}
+
+void ReadTileRange(char const* name, TileRange& range)
+{
+    char const* value = getenv(name);
+    if (!value)
+        return;
+
+    int32 lo, hi;
+    char tail;
+    if (sscanf(value, "%d,%d%c", &lo, &hi, &tail) != 2 || lo < 0 || hi < lo || hi >= WDT_MAP_SIZE)
+        FailSelection(name, value);
+
+    range = { lo, hi };
+}
+
+void ReadSelection()
+{
+    char const* map = getenv("SPF_MAP");
+    bool hasRange = getenv("SPF_ROWS") || getenv("SPF_COLS");
+    if (!map)
+    {
+        if (hasRange)
+        {
+            printf("SPF_ROWS and SPF_COLS need SPF_MAP\n");
+            exit(1);
+        }
+        return;
+    }
+
+    char tail;
+    if (sscanf(map, "%u%c", &SpfMap, &tail) != 1)
+        FailSelection("SPF_MAP", map);
+
+    SpfSelected = true;
+    ReadTileRange("SPF_ROWS", SpfRows);
+    ReadTileRange("SPF_COLS", SpfCols);
+}
+
+bool IsTileSelected(uint32 mapId, int32 row, int32 col)
+{
+    return !SpfSelected || (mapId == SpfMap && row >= SpfRows.Lo && row <= SpfRows.Hi && col >= SpfCols.Lo && col <= SpfCols.Hi);
+}
