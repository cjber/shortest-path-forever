+                    HazardPoint const g[3] = { pts[0], pts[k], pts[k + 1] };
+                    under = GroundTriangleUnderHazard(g, h, mesh.ch * 0.5f);
+                }
+
+                if (under)
+                    break;
+            }
+
+            if (under)
+                mesh.flags[i] |= NAV_FLAG_UNDER_HAZARD;
+        }
+    }
