+    // SPF-HAZARD-BEGIN
+    struct HazardPoint { float x, y, z; };
+
+    // Sutherland-Hodgman clip of a convex polygon against the XZ projection of a triangle. Each vertex carries the
+    // ground height and the hazard height at its position, interpolated along the clipped edges.
+    struct HazardClipVertex { float x, z, ground, hazard; };
+
+    static float HazardCross(float ax, float az, float bx, float bz, float px, float pz)
+    {
+        return (bx - ax) * (pz - az) - (bz - az) * (px - ax);
+    }
+
+    // Does any part of the ground triangle g lying under the hazard triangle h sit lower than it by more than minDrop?
+    static bool GroundTriangleUnderHazard(HazardPoint const (&g)[3], HazardPoint const (&h)[3], float minDrop)
+    {
+        float const gDet = HazardCross(g[0].x, g[0].z, g[1].x, g[1].z, g[2].x, g[2].z);
+        float const hDet = HazardCross(h[0].x, h[0].z, h[1].x, h[1].z, h[2].x, h[2].z);
+        if (std::fabs(gDet) < 1e-9f || std::fabs(hDet) < 1e-9f)
+            return false;
+
+        auto heightAt = [](HazardPoint const (&t)[3], float det, float x, float z)
+        {
+            float l0 = HazardCross(x, z, t[1].x, t[1].z, t[2].x, t[2].z) / det;
+            float l1 = HazardCross(t[0].x, t[0].z, x, z, t[2].x, t[2].z) / det;
+            float l2 = 1.0f - l0 - l1;
+            return l0 * t[0].y + l1 * t[1].y + l2 * t[2].y;
+        };
+
+        // the polygon being clipped is the ground triangle, the clip edges are the hazard triangle's, wound counter-clockwise
+        float const sign = hDet > 0.0f ? 1.0f : -1.0f;
+        std::vector<HazardClipVertex> poly, next;
+        for (HazardPoint const& p : g)
+            poly.push_back({ p.x, p.z, p.y, heightAt(h, hDet, p.x, p.z) });
+
+        for (int e = 0; e < 3 && !poly.empty(); ++e)
+        {
+            HazardPoint const& ea = h[e];
+            HazardPoint const& eb = h[(e + 1) % 3];
+            auto side = [&](HazardClipVertex const& v) { return sign * HazardCross(ea.x, ea.z, eb.x, eb.z, v.x, v.z); };
+
+            next.clear();
+            for (std::size_t i = 0; i < poly.size(); ++i)
+            {
+                HazardClipVertex const& cur = poly[i];
+                HazardClipVertex const& prev = poly[(i + poly.size() - 1) % poly.size()];
+                float sc = side(cur), sp = side(prev);
+                if ((sc >= 0.0f) != (sp >= 0.0f))
+                {
+                    float t = sp / (sp - sc);
+                    next.push_back({ prev.x + (cur.x - prev.x) * t, prev.z + (cur.z - prev.z) * t,
+                        prev.ground + (cur.ground - prev.ground) * t, prev.hazard + (cur.hazard - prev.hazard) * t });
+                }
+                if (sc >= 0.0f)
+                    next.push_back(cur);
+            }
+            poly.swap(next);
+        }
+
+        if (poly.size() < 3)
+            return false;
 
-        OnTileDone();
+        // an overlap that is only a shared edge or a corner is not "under"
+        float area = 0.0f;
+        for (std::size_t i = 0; i < poly.size(); ++i)
+        {
+            HazardClipVertex const& a = poly[i];
+            HazardClipVertex const& b = poly[(i + 1) % poly.size()];
+            area += a.x * b.z - b.x * a.z;
+        }
+        if (std::fabs(area) * 0.5f < 1e-4f)
+            return false;
+
+        // both heights are linear over the overlap, so their difference is extreme at a vertex
+        for (HazardClipVertex const& v : poly)
+            if (v.hazard - v.ground > minDrop)
+                return true;
+
+        return false;
     }
 
+    // Terrain is dropped where a quad's liquid lies wholly above it, but model floors and partly submerged quads keep
+    // ground below the surface. Under water gen_nav discards that bed itself; under magma or slime the polygon must be
+    // flagged here, because ground is the area recast prefers over the liquid it sits in. Every ground polygon is
+    // clipped against every hazard triangle over it, so a small hazard inside a large polygon is found as well.
+    static void MarkGroundUnderHazard(rcPolyMesh& mesh, float const* lVerts, int const* lTris, uint8 const* lTriFlags, int lTriCount)
+    {
+        constexpr float CELL = 8.0f;
+        std::unordered_map<uint64, std::vector<int>> buckets;
+        auto key = [](int cx, int cz) { return (uint64(uint32(cx)) << 32) | uint64(uint32(cz)); };
+        for (int t = 0; t < lTriCount; ++t)
+        {
+            if (lTriFlags[t] != NAV_AREA_MAGMA_SLIME)
+                continue;
+
+            float const* a = &lVerts[lTris[t * 3 + 0] * 3];
+            float const* b = &lVerts[lTris[t * 3 + 1] * 3];
+            float const* c = &lVerts[lTris[t * 3 + 2] * 3];
+            int x0 = int(std::floor(std::min({ a[0], b[0], c[0] }) / CELL)), x1 = int(std::floor(std::max({ a[0], b[0], c[0] }) / CELL));
+            int z0 = int(std::floor(std::min({ a[2], b[2], c[2] }) / CELL)), z1 = int(std::floor(std::max({ a[2], b[2], c[2] }) / CELL));
+            for (int cx = x0; cx <= x1; ++cx)
+                for (int cz = z0; cz <= z1; ++cz)
+                    buckets[key(cx, cz)].push_back(t);
+        }
+
+        if (buckets.empty())
+            return;
+
+        int const nvp = mesh.nvp;
+        std::vector<int> candidates;
+        for (int i = 0; i < mesh.npolys; ++i)
+        {
+            if ((mesh.areas[i] & NAV_AREA_ALL_MASK) != NAV_AREA_GROUND)
+                continue;
+
+            unsigned short const* poly = &mesh.polys[i * nvp * 2];
+            std::vector<HazardPoint> pts;
+            float minX = FLT_MAX, maxX = -FLT_MAX, minZ = FLT_MAX, maxZ = -FLT_MAX;
+            for (int j = 0; j < nvp && poly[j] != RC_MESH_NULL_IDX; ++j)
+            {
+                unsigned short const* v = &mesh.verts[poly[j] * 3];
+                HazardPoint p = { mesh.bmin[0] + v[0] * mesh.cs, mesh.bmin[1] + v[1] * mesh.ch, mesh.bmin[2] + v[2] * mesh.cs };
+                minX = std::min(minX, p.x);
+                maxX = std::max(maxX, p.x);
+                minZ = std::min(minZ, p.z);
+                maxZ = std::max(maxZ, p.z);
+                pts.push_back(p);
+            }
+
+            if (pts.size() < 3)
+                continue;
+
+            candidates.clear();
+            for (int cx = int(std::floor(minX / CELL)); cx <= int(std::floor(maxX / CELL)); ++cx)
+                for (int cz = int(std::floor(minZ / CELL)); cz <= int(std::floor(maxZ / CELL)); ++cz)
+                {
+                    auto bucket = buckets.find(key(cx, cz));
+                    if (bucket != buckets.end())
+                        candidates.insert(candidates.end(), bucket->second.begin(), bucket->second.end());
+                }
+
+            std::ranges::sort(candidates);
+            candidates.erase(std::ranges::unique(candidates).begin(), candidates.end());
+
+            bool under = false;
+            for (int t : candidates)
+            {
+                float const* a = &lVerts[lTris[t * 3 + 0] * 3];
+                float const* b = &lVerts[lTris[t * 3 + 1] * 3];
+                float const* c = &lVerts[lTris[t * 3 + 2] * 3];
+                HazardPoint const h[3] = { { a[0], a[1], a[2] }, { b[0], b[1], b[2] }, { c[0], c[1], c[2] } };
+                for (std::size_t k = 1; k + 1 < pts.size() && !under; ++k)
