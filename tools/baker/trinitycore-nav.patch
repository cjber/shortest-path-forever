+    bool WriteTileStatus(boost::filesystem::path const& path, std::string_view text)
+    {
+        boost::system::error_code error;
+        boost::filesystem::create_directories(path.parent_path(), error);
+        boost::filesystem::path partial = path.string() + ".partial";
+        {
+            std::ofstream out(partial.string(), std::ios::binary | std::ios::trunc);
+            out << text << '\n';
+            out.flush();
+            if (!out)
+            {
+                TC_LOG_ERROR("maps.mmapgen", "Failed to write the tile status {}", partial.string());
+                return false;
+            }
+        }
+
+        boost::filesystem::rename(partial, path, error);
+        if (error)
+        {
+            TC_LOG_ERROR("maps.mmapgen", "Failed to publish the tile status {}: {}", path.string(), error.message());
+            return false;
+        }
+
+        return true;
+    }
+
+    std::string ReadTileStatus(boost::filesystem::path const& path)
+    {
+        std::ifstream in(path.string());
+        std::string word;
+        in >> word;
+        return word;
+    }
